# Copy to .env. Every variable is validated when the API starts; a missing or
# malformed one stops it with the variable named, rather than failing later
# somewhere unrelated.

POSTGRES_USER=panna
POSTGRES_PASSWORD=panna
POSTGRES_DB=panna

DATABASE_URL=postgresql://panna:panna@localhost:5433/panna

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random

PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# 0003 fills these in. Present but empty is fine until then.
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_CLIENT_ID=
ALLOW_DEV_SIGN_IN=true