{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    // CommonJS cannot carry ESM syntax verbatim. See the note in CLAUDE.md.
    "verbatimModuleSyntax": false,
    // NestJS and ts-rest use legacy parameter decorators, which is also what
    // emitDecoratorMetadata needs in order to record types for injection.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts", "vitest.config.ts"]
}
