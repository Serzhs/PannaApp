+// Xcode 26.3's compiler does not honour `nonisolated(unsafe)` on a captured weak local and reports a
+// data race; an `@unchecked Sendable` box carries the same promise in a form it accepts.
+private final class UnsafeWeakEmitter<Emitter: AnyObject>: @unchecked Sendable {
+  weak var value: Emitter?
+
+  init(_ value: Emitter) {
+    self.value = value
+  }
+}
