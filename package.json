{
  "name": "panna",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "docker compose up -d --wait database && pnpm --filter api db:migrate && pnpm --filter api dev",
    "mobile": "pnpm --filter @panna/mobile start",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm audit --audit-level high",
    "format": "prettier --write .",
    "build": "pnpm --filter @panna/shared build && pnpm --filter @panna/api build",
    "db:up": "docker compose up -d --wait database",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait database && pnpm --filter api db:migrate && pnpm db:seed",
    "db:studio": "pnpm --filter api db:studio",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:generate": "pnpm --filter api db:generate",
    "db:seed": "pnpm --filter api db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.3.0",
      "react-dom": "19.2.3"
    }
  }
}
